##############################################################################
# YourWaves — environment template
#
# Copy to `.env.local` and fill in. Never commit a filled-in file: only this
# template is tracked (see .gitignore).
#
# NEXT_PUBLIC_* values are inlined into the client bundle and are therefore
# PUBLIC. Everything else stays server-only — never prefix a secret.
#
# Nothing here is wired up in phase 0. Phases noted per block.
##############################################################################

# --- App ---------------------------------------------------------------------
# Canonical origin, no trailing slash. Used for absolute URLs in emails,
# payment return URLs and OG tags. e.g. https://yourwaves.qa
NEXT_PUBLIC_SITE_URL=


# --- Database (phase 2) -------------------------------------------------------
# THE one variable that matters. Everything — the app, migrations, the seeder —
# reads this. Schema and migrations are identical on Supabase and on a plain
# Postgres, so this is the only thing that changes between them.
#
# LOCAL:
#   postgresql://<you>@localhost:5432/yourwaves_dev
#
# SUPABASE — Project Settings → Database → Connection string.
# Three options are offered and they are NOT interchangeable:
#
#   Session pooler  (...pooler.supabase.com:5432)   ← USE THIS
#       IPv4, one backend per connection. Supports prepared statements,
#       advisory locks and multi-statement transactions, all of which the
#       migrator and create_booking_hold() rely on.
#
#   Transaction pooler (...pooler.supabase.com:6543)
#       IPv4, a backend per transaction. The client disables prepared
#       statements automatically when it sees :6543, but advisory locks do not
#       survive between statements — do NOT run migrations through it.
#
#   Direct  (db.<ref>.supabase.co:5432)
#       IPv6-only on the free tier, so it fails to resolve on many networks
#       and on most CI runners.
#
# The password is URL-encoded: @ : / ? # [ ] must be percent-escaped.
# Verify any change with `pnpm db:check` before anything else.
DATABASE_URL=
# Used by `pnpm test`. MUST be a different database whose name ends in _test —
# the suite truncates tables and the harness refuses anything else.
# Keep this pointing at a LOCAL Postgres: the suite is destructive and runs
# often, and you do not want it billing against a hosted project.
TEST_DATABASE_URL=


# --- Supabase (phase 2: database) --------------------------------------------
# Project URL, e.g. https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Anon/publishable key. Currently unused: customers are anonymous and never
# query Supabase directly — every read goes through a server route. RLS is
# deny-all, so this key can reach nothing even if it leaks.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key. Bypasses row level security — server-side only, never
# expose this to the client. Needed from phase 7 for Supabase-side auth.
SUPABASE_SERVICE_ROLE_KEY=


# --- Payments (phase 6) -------------------------------------------------------
# Which provider takes the money.
#   skipcash  SkipCash (Qatar). REQUIRED in production.
#   mock      Local simulator with SIGNED webhooks. Development only — the app
#             refuses to start with this in production, rather than confirming
#             bookings for free.
PAYMENT_PROVIDER=mock
# Signs the mock provider's webhooks so the real verification path is exercised
# locally. Any string.
MOCK_PAYMENT_SECRET=


# --- SkipCash (payments) -----------------------------------------------------
# Merchant onboarding, fees and subscriptions are the CLIENT's responsibility
# (SRS operational notice) — see docs/payments-setup.md.
#
# All four credentials come from the SkipCash merchant portal. Docs and the
# sandbox live at https://dev.skipcash.app.
#
#   Sandbox     https://skipcashtest.azurewebsites.net
#   Production  https://api.skipcash.app
#
# Start on sandbox. `node scripts/payments-probe.mjs config` tells you which of
# the two you are pointed at before you create anything.
SKIPCASH_API_URL=https://skipcashtest.azurewebsites.net
# Authenticates the GET that reads a payment back. NOT used on checkout —
# SkipCash authenticates that with the signature alone.
SKIPCASH_CLIENT_ID=
# Sent as the `KeyId` field, and therefore part of the signed string.
SKIPCASH_KEY_ID=
# Signs outbound payment-creation requests (HMAC-SHA256 → base64, over an
# order- and CASE-sensitive `Key=Value,...` string). A mismatch is a bare 401
# with no explanation, so if checkout fails start here:
#   node scripts/payments-probe.mjs checkout
SKIPCASH_SECRET_KEY=
# Verifies inbound webhooks. A DIFFERENT value from SKIPCASH_SECRET_KEY — the
# portal issues a separate webhook key. Setting them to the same thing is the
# obvious mistake and it fails closed: every callback is rejected as a forgery,
# and bookings then confirm only via the reconcile cron, minutes late.
#
# The webhook URL itself is configured in the portal (Sandbox → Credentials),
# not sent per-request. Point it at:
#   https://<your-domain>/api/payments/webhook
SKIPCASH_WEBHOOK_SECRET=


# --- OTP phone verification (phase 4) ----------------------------------------
# Which channel delivers the code.
#   whatsapp  WhatsApp Cloud API. REQUIRED in production.
#   console   Prints the code to the server log. Development only — the app
#             refuses to start the OTP flow with this in production, rather
#             than silently logging one-time codes to stdout.
OTP_CHANNEL=console
# Signs the 30-minute phone-verification token. At least 32 characters.
#   openssl rand -base64 48
# Rotating this invalidates every in-flight verification, which is what you
# want if it is ever exposed.
OTP_TOKEN_SECRET=
# Returns the code in the /api/otp/send response. Requires NODE_ENV !==
# production as well, so a production build that inherits it still leaks
# nothing. Never set this in a deployed environment.
OTP_DEV_ECHO=


# --- WhatsApp Cloud API (OTP + booking notifications) ------------------------
# Provisioning is the client's responsibility and cannot be done from the
# codebase — see docs/whatsapp-setup.md. Messaging is billed per message.
#
# Phone number ID, not the phone number itself (WhatsApp Manager → API Setup).
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Permanent SYSTEM USER access token. The temporary token in the API Setup tab
# expires after 24 hours and will take verification down with it.
WHATSAPP_ACCESS_TOKEN=
# Approved authentication-category template: one body parameter + copy-code
# button, localised for ar and en.
WHATSAPP_OTP_TEMPLATE_NAME=yourwaves_otp
WHATSAPP_OTP_TEMPLATE_LANG_AR=ar
WHATSAPP_OTP_TEMPLATE_LANG_EN=en
# Token echoed back during webhook subscription handshake — you choose this.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Meta app secret, for validating webhook payload signatures.
WHATSAPP_APP_SECRET=


# --- Hold sweeper (phase 5) ---------------------------------------------------
# Shared secret for POST /api/cron/sweep-holds, the HTTP fallback for the
# pg_cron job in drizzle/0005_booking_holds.sql. Only needed where pg_cron is
# unavailable or not schedulable — on Supabase the job schedules itself.
# Sent as either `Authorization: Bearer <secret>` or `x-cron-secret`.
#   openssl rand -base64 32
CRON_SECRET=


# --- Resend (transactional email) --------------------------------------------
RESEND_API_KEY=
# Verified sender, e.g. "YourWaves <bookings@yourwaves.qa>"
RESEND_FROM_EMAIL=
# Internal inbox that receives new-booking alerts.
BOOKINGS_NOTIFICATION_EMAIL=


# --- Google Maps (villa location picker) -------------------------------------
# Browser key — MUST be restricted by HTTP referrer in Google Cloud Console.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Server key for geocoding/distance calls, restricted by IP.
GOOGLE_MAPS_SERVER_API_KEY=

# ---------------------------------------------------------------------------
# Notifications (phase 7) — the outbox worker's transports
#
# Both default to "console", which prints instead of delivering, and BOTH ARE A
# HARD ERROR in a production build. Accounts, domains and message fees are the
# CLIENT's responsibility (SRS operational notice) — see
# docs/notifications-setup.md and docs/whatsapp-templates.md.
# ---------------------------------------------------------------------------

# resend | console
EMAIL_PROVIDER=console
RESEND_API_KEY=
# Must be on a domain verified with the provider, or every send is rejected.
EMAIL_FROM="YourWaves <hello@yourwaves.qa>"
EMAIL_REPLY_TO=

# cloud | console. `cloud` reuses WHATSAPP_PHONE_NUMBER_ID / WHATSAPP_ACCESS_TOKEN
# from the phase-4 OTP block above — one business number sends both.
WHATSAPP_PROVIDER=console

# Where the console email transport writes rendered HTML for inspection.
NOTIFICATION_DEV_DIR=.dev-outbox

# Shown to customers as the support number in emails and WhatsApp copy.
NEXT_PUBLIC_SUPPORT_PHONE="+974 5512 3456"

# RETIRED in phase 8. The back office now uses Supabase Auth sessions; see the
# admin block below and docs/admin-setup.md. Left here only as a note that a
# stale value in an old .env does nothing — check:admin-auth asserts that.
# ADMIN_API_SECRET=

# ---------------------------------------------------------------------------
# Back office (phase 8)
#
# Without these the admin UI is CLOSED, not open: pages redirect to a login
# screen that explains what is missing, and every admin API answers 503.
# Supabase's SDK is used ONLY for authentication — data still goes through
# DATABASE_URL. See docs/admin-setup.md.
# ---------------------------------------------------------------------------

# Project Settings → API. The anon key is safe in the browser: RLS denies it
# everything. The service role key is NOT needed.
# NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_ANON_KEY are declared in the
# Supabase block above — fill them in to enable the back office.

# Enable TOTP under Authentication → Multi-Factor. MFA is mandatory for admins
# and enforced server-side: a password-only session counts as signed out.
